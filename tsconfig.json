{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@types/*": ["types/*"],
      "@shared/*": ["shared/*"]
    }
  },
  "include": [
    "types/**/*.ts",
    "shared/**/*.ts",
    "hooks/**/*.ts",
    "engine/**/*.ts",
    "daemon/**/*.ts",
    "storage/**/*.ts",
    "scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests"
  ]
}
